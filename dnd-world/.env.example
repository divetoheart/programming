# Private access. Leave blank only for local development.
GAME_PASSCODE=
SESSION_SECRET=

# GitHub-backed save ledger.
# Use a fine-grained token limited to divetoheart/programming Contents: Read and write.
GITHUB_SAVE_TOKEN=
GITHUB_SAVE_REPO=divetoheart/programming
GITHUB_SAVE_BRANCH=campaign-data
GITHUB_SAVE_PATH=dnd-world/data/campaign.json

# Optional AI narrator. Any OpenAI-compatible chat-completions endpoint works.
# Without these, the mechanical game remains playable with the built-in fallback narrator.
AI_API_KEY=
AI_CHAT_URL=
AI_MODEL=
